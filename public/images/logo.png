<svg width="200" height="200" viewBox="0 0 200 200"
     xmlns="http://www.w3.org/2000/svg">
  <!-- Background circle -->
  <circle cx="100" cy="100" r="95" fill="#000000" stroke="#FFD700" stroke-width="6"/>

  <!-- Outer golden ring -->
  <circle cx="100" cy="100" r="75" fill="none" stroke="#FFD700" stroke-width="4"/>

  <!-- Token coin in center -->
  <circle cx="100" cy="100" r="45" fill="#FFD700"/>
  <circle cx="100" cy="100" r="35" fill="#FFEE99"/>

  <!-- S letter -->
  <path d="M80 80
           C70 70, 70 60, 90 55
           C115 50, 125 60, 120 70
           C115 80, 95 82, 90 90
           C85 98, 95 105, 110 105
           C125 105, 130 115, 120 125
           C110 135, 90 135, 80 125"
        fill="none" stroke="#B8860B" stroke-width="6" stroke-linecap="round"/>

  <!-- Spin rays -->
  <line x1="100" y1="15" x2="100" y2="35" stroke="#FFD700" stroke-width="4"/>
  <line x1="185" y1="100" x2="165" y2="100" stroke="#FFD700" stroke-width="4"/>
  <line x1="100" y1="185" x2="100" y2="165" stroke="#FFD700" stroke-width="4"/>
  <line x1="15" y1="100" x2="35" y2="100" stroke="#FFD700" stroke-width="4"/>

  <!-- Text: SPINWIN TOKEN -->
  <text x="100" y="185" text-anchor="middle"
        font-family="Arial, sans-serif"
        font-size="16" fill="#FFD700" letter-spacing="2">
    SPINWIN TOKEN
  </text>
</svg>
